// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum ContentType {
  NOVEL
  STORY
  PODCAST
  EDUCATIONAL
  MOTIVATION
}

model Users {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  name                String
  role                UserRole @default(USER)
  status              UserStatus @default(ACTIVE)
  deletedAt           DateTime?
  scheduledDeletionAt DateTime?


  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  userProfile UserProfile?
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model UserProfile {
  id          String  @id @default(uuid())
  displayName String? // ← optional — user hasn't filled it in yet on register
  avatarUrl   String?
  bio         String?
  preferences Json    @default("{}")

  userId String @unique
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  listening   ListeningHistory[]
  favorite    Favorite []

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Category {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  iconName  String?
  colorHex  String?
  sortOrder Int     @unique

  audioContent AudioContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Author {
  id        String @id @default(uuid())
  name      String
  bio       String
  avatarUrl String?

  audioContent AudioContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AudioContent {
  id          String @id @default(uuid())
  title       String
  slug        String @unique
  description String
  coverUrl    String
  audioUrl    String
  durationSec Int
  contentType ContentType @default(NOVEL)
  language    String?
  isPublished Boolean @default(false)
  playCount   Int

  authorId    String
  categoryId  String

  author      Author? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  listening   ListeningHistory[]
  favorite    Favorite []

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([authorId])
  @@index([isPublished])
}


model ListeningHistory {
  id              String @id @default(uuid())
  positionSec     Int
  progressPercent Decimal
  completed       Boolean @default(false)
  lastPlayedAt    DateTime @default(now())

  userId          String
  contentId       String

  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  content           AudioContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  

  @@unique([userId, contentId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lastPlayedAt])
}


model Favorite {
  id              String @id @default(uuid())
  userId          String
  contentId       String

  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         AudioContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
